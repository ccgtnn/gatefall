  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:battle": "node --test \"tests/battle/*.test.js\"",
    "test:economy": "node --test \"tests/economy/*.test.js\"",
    "test:bot": "node --test \"tests/bot/*.test.js\"",
    "arena": "node tools/arena.mjs",
